DJANGO_DEBUG=true
# Required for production; generate with secrets.token_urlsafe(50).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
FRONTEND_URL=http://localhost:3000
# Leave DATABASE_URL empty for local SQLite. Docker Compose sets PostgreSQL automatically.
DATABASE_URL=
# Required for Docker Compose; use a randomly generated URL-safe value.
POSTGRES_PASSWORD=
# Optional shared cache; Docker Compose uses Redis automatically.
REDIS_URL=
DJANGO_TRUST_PROXY=false
DJANGO_NUM_PROXIES=0
# Optional CRM contract: see README. No network delivery occurs without configuration.
CRM_WEBHOOK_URL=
CRM_API_TOKEN=

# DEO CRM protocol v1 (set both this and CRM_API_TOKEN after installing the receiver).
CRM_INTEGRATION_MODE=deo_core
# CRM_WEBHOOK_URL=https://crm.backend.deo-core.codes/api/v1/leads/website/
# Local integration tests only; this is ignored when DJANGO_DEBUG=false.
CRM_ALLOW_LOCAL_HTTP=false
